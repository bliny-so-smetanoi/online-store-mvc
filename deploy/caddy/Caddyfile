# HTTPS-сертификат Let's Encrypt выпускается автоматически для {$DOMAIN}
# (домен должен указывать на сервер, порты 80/443 открыты).
{$DOMAIN} {
	encode gzip

	# Keycloak (KC_HTTP_RELATIVE_PATH=/auth)
	@keycloak path /auth /auth/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Приложение
	handle {
		reverse_proxy app:8080
	}
}
