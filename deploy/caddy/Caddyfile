# The certificate for {$DOMAIN} is chosen by CADDY_TLS in .env:
#   acme     — Let's Encrypt (domain points to the server, ports 80/443 reachable from the internet)
#   internal — self-signed certificate from Caddy's built-in CA (local network, VirtualBox)
{$DOMAIN} {
	tls {
		issuer {$CADDY_TLS:acme}
	}

	encode gzip

	# Keycloak (KC_HTTP_RELATIVE_PATH=/auth)
	@keycloak path /auth /auth/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Application
	handle {
		reverse_proxy app:8080
	}
}
