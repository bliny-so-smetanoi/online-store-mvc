# Сертификат для {$DOMAIN} задаётся CADDY_TLS в .env:
#   acme     — Let's Encrypt (домен указывает на сервер, порты 80/443 доступны из интернета)
#   internal — самоподписанный сертификат от встроенного CA Caddy (локальная сеть, VirtualBox)
{$DOMAIN} {
	tls {
		issuer {$CADDY_TLS:acme}
	}

	encode gzip

	# Keycloak (KC_HTTP_RELATIVE_PATH=/auth)
	@keycloak path /auth /auth/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Приложение
	handle {
		reverse_proxy app:8080
	}
}
