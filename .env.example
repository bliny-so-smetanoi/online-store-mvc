# Скопируйте в .env и заполните: cp .env.example .env
# .env не коммитится (.gitignore).

# Домен, который указывает на сервер (A-запись). Caddy сам получит HTTPS-сертификат.
# Нет домена — можно взять бесплатный вида 203-0-113-10.sslip.io (IP сервера через дефисы).
DOMAIN=store.example.com

# Откуда берётся HTTPS-сертификат:
#   acme     — Let's Encrypt; DOMAIN должен указывать на сервер, 80/443 доступны из интернета
#   internal — самоподписанный (локальная сеть, VirtualBox, DOMAIN=localhost или IP);
#              браузер покажет предупреждение, на клиентах нужна запись в hosts для домена
CADDY_TLS=internal

# Пароль sa для SQL Server: минимум 8 символов, буквы разного регистра + цифры/символы.
# Не используйте ; и ' — пароль подставляется в строку подключения.
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassword
# Express (бесплатно, до 10 ГБ на БД) / Developer / Standard / Enterprise
MSSQL_PID=Express
# Внешний доступ к SQL Server (логин sa). 0.0.0.0 — открыт для всех адресов,
# 127.0.0.1 — только с сервера (подключаться через ssh -L 1433:localhost:1433 user@server).
# Docker обходит ufw: ограничивайте доступ firewall'ом провайдера или через MSSQL_BIND.
MSSQL_BIND=0.0.0.0
MSSQL_PORT=1433
APP_DB_NAME=OnlineStore
KEYCLOAK_DB_NAME=KeycloakIdentity

# Администратор Keycloak (консоль: https://DOMAIN/auth/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KeycloakAdmin

# Секреты клиентов realm web-net. Сгенерировать: openssl rand -hex 24
# Применяются только при первом импорте realm (пустая БД Keycloak).
MVC_CLIENT_SECRET=
BACKEND_ADMIN_CLIENT_SECRET=

# Порт UI Seq на localhost сервера
SEQ_UI_PORT=5341
