# Copy to .env and fill in: cp .env.example .env
# .env is not committed (.gitignore).

# Domain pointing to the server (A record). Caddy obtains the HTTPS certificate itself.
# No domain? Use a free one like 203-0-113-10.sslip.io (server IP with dashes).
DOMAIN=store.example.com

# Where the HTTPS certificate comes from:
#   acme     — Let's Encrypt; DOMAIN must point to the server, 80/443 reachable from the internet
#   internal — self-signed (local network, VirtualBox, DOMAIN=localhost or IP);
#              the browser shows a warning; clients need a hosts entry for the domain
CADDY_TLS=internal

# SQL Server sa password: at least 8 characters, mixed-case letters + digits/symbols.
# Do not use ; or ' — the password is inserted into the connection string.
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassword
# Express (free, up to 10 GB per DB) / Developer / Standard / Enterprise
MSSQL_PID=Express
# External access to SQL Server (login sa). 0.0.0.0 — open to all addresses,
# 127.0.0.1 — server only (connect via ssh -L 1433:localhost:1433 user@server).
# Docker bypasses ufw: restrict access with the provider's firewall or via MSSQL_BIND.
MSSQL_BIND=0.0.0.0
MSSQL_PORT=1433
APP_DB_NAME=OnlineStore
KEYCLOAK_DB_NAME=KeycloakIdentity

# Keycloak administrator (console: https://DOMAIN/auth/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KeycloakAdmin

# Client secrets for realm web-net. Generate with: openssl rand -hex 24
# Applied only on the first realm import (empty Keycloak DB).
MVC_CLIENT_SECRET=
BACKEND_ADMIN_CLIENT_SECRET=

# Seq UI port on the server's localhost
SEQ_UI_PORT=5341
