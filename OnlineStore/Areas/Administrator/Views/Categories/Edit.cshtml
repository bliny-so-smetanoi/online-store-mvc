@model Application.UseCases.Categories.Dtos.CategoryDto
@using Resource
@{
    var isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "Add Category" : "Edit Category";
}
<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <form method="post" action="@(isNew ? Url.Action("Create") : Url.Action("Update", new { id = Model.Id }))">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" required maxlength="200" />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" maxlength="2000"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="ParentId" class="form-label">Parent</label>
            <select asp-for="ParentId" asp-items="ViewBag.Parents" class="form-select">
                <option value="">No parent</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </form>
</div>