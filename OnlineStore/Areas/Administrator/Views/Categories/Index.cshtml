@model List<Application.UseCases.Categories.Dtos.CategoryDto>
@using Resource
@{
    ViewData["Title"] = "Categories";
}
<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary mb-3" asp-action="Add">Add category</a>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Parent</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="4">No categories</td></tr>
        }
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@(category.ParentName ?? "No parent category")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Edit category</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Delete category</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>