@model List<Application.UseCases.Categories.Dtos.CategoryDto>
@using Resource
@{
    ViewData["Title"] = CatalogResources.Get("Categories");
}
<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary mb-3" asp-action="Add">@CatalogResources.Get("AddCategory")</a>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@CatalogResources.Get("CategoryName")</th>
            <th>@CatalogResources.Get("Description")</th>
            <th>@CatalogResources.Get("ParentCategory")</th>
            <th>@CatalogResources.Get("CategoryActions")</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="4">@CatalogResources.Get("NoCategories")</td></tr>
        }
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@(category.ParentName ?? CatalogResources.Get("NoParentCategory"))</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">@CatalogResources.Get("EditCategory")</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">@CatalogResources.Get("DeleteCategory")</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>