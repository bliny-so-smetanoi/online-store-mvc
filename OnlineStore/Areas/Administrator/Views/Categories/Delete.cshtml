@model Application.UseCases.Categories.Dtos.CategoryDto
@using Resource
@{
    ViewData["Title"] = CatalogResources.Get("DeleteCategory");
}
<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <p>@CatalogResources.Get("ConfirmDeleteCategory") <strong>@Model.Name</strong></p>
    <p>@Model.Description</p>
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">@CatalogResources.Get("DeleteCategory")</button>
        <a asp-action="Index" class="btn btn-secondary">@CatalogResources.Get("BackToCategories")</a>
    </form>
</div>