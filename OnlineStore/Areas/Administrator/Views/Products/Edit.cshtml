@{
    ViewData["Title"] = "Edit product";
}

<div class="container-fluid">

    <p class="h3 mb-4">Edit product</p>

    <form id="updateProductForm" class="container mt-3">

        <input
            type="hidden"
            id="productId"
            value="@ViewContext.RouteData.Values["id"]"
        />

        <div class="mb-3">

            <label
                for="administratorProductsView_name"
                class="form-label"
            >
                Name
            </label>

            <input
                id="administratorProductsView_name"
                type="text"
                class="form-control"
            />

            <div
                id="nameError"
                class="invalid-feedback"
            ></div>

        </div>

        <div class="mb-3">

            <label
                for="administratorProductsView_description"
                class="form-label"
            >
                Description
            </label>

            <input
                id="administratorProductsView_description"
                type="text"
                class="form-control"
            />

            <div
                id="descriptionError"
                class="invalid-feedback"
            ></div>

        </div>

        <div class="mb-3">

            <label
                for="administratorProductsView_price"
                class="form-label"
            >
                Price
            </label>

            <input
                id="administratorProductsView_price"
                type="text"
                class="form-control"
            />

            <div
                id="priceError"
                class="invalid-feedback"
            ></div>

        </div>

        <div class="mb-3">

            <label
                for="administratorProductsView_quantity"
                class="form-label"
            >
                Quantity
            </label>

            <input
                id="administratorProductsView_quantity"
                type="text"
                class="form-control"
            />

            <div
                id="quantityError"
                class="invalid-feedback"
            ></div>

        </div>
        
        <div class="mb-3">

            <label
                for="formFileMultiple"
                class="form-label"
            >
                Product images
            </label>

            <input
                class="form-control"
                type="file"
                id="formFileMultiple"
                multiple
                accept="image/*"
            />

        </div>

        <div
            id="imagePreview"
            class="d-flex flex-wrap gap-3 mb-3"
        ></div>

        <button
            id="updateProductBtn"
            type="submit"
            class="btn btn-primary"
        >
            Save
        </button>

    </form>

</div>

@section Scripts
{
    <script src="~/js/src/areas/administrator/views/products/edit.bundle.js"></script>
}