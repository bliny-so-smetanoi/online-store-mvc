@using Resource
<div class="container mt-4">
        
    <p class="h3">Product list</p>
    <a class="btn btn-primary" asp-action="Add">Add product</a>
    
    <table class="table table-striped table-bordered mt-4">
        <thead>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">Price</th>
        <th scope="col">Quantity</th>
        <th scope="col">Category</th>
        <th scope="col">Created date</th>
        <th scope="col"></th>
        <tr>
            <td> <input class="form-control form-control-sm column-search" data-field="id" placeholder="Id"/> </td> 
            <td> <input class="form-control form-control-sm column-search" data-field="name" placeholder="Name"/> </td> 
            <td> <input class="form-control form-control-sm column-search" data-field="price" placeholder="Price"/> </td>
            <td> <input class="form-control form-control-sm column-search" data-field="quantity" placeholder="Quantity"/> </td>
            <td>
                <select class="form-select form-select-sm column-search" data-field="categoryId"
                        asp-items="ViewBag.Categories" aria-label="@CatalogResources.Get("Category")">
                    <option value="">@CatalogResources.Get("AllCategories")</option>
                </select>
            </td>
            <td> <input class="form-control form-control-sm column-search" data-field="created" placeholder="Created"/> </td>
        </tr>
        </thead>
    
        <tbody id="about-table-body" class="table-group-divider">
        </tbody>
    </table>
    <nav aria-label="Todo pagination">
        <ul class="pagination pagination-sm" id="about-pagination"></ul>
    </nav>
    
</div>




@section Scripts
{ 
    <script src="~/js/src/areas/administrator/views/products/index.bundle.js"></script>
}
