@using Resource
@{
    ViewData["Title"] = CatalogResources.Get("ProductList");
}
<div class="container mt-4">
        
    <p class="h3">@CatalogResources.Get("ProductList")</p>
    <a class="btn btn-primary" asp-action="Add">@CatalogResources.Get("AddProduct")</a>
    
    <table class="table table-striped table-bordered mt-4">
        <thead>
        <th scope="col">Id</th>
        <th scope="col">@CatalogResources.Get("ProductName")</th>
        <th scope="col">@CatalogResources.Get("Price")</th>
        <th scope="col">@CatalogResources.Get("Quantity")</th>
        <th scope="col">@CatalogResources.Get("Category")</th>
        <th scope="col">@CatalogResources.Get("CreatedDate")</th>
        <th scope="col"></th>
        <tr>
            <td> <input class="form-control form-control-sm column-search" data-field="id" placeholder="Id"/> </td> 
            <td> <input class="form-control form-control-sm column-search" data-field="name" placeholder="@CatalogResources.Get("ProductName")"/> </td> 
            <td> <input class="form-control form-control-sm column-search" data-field="price" placeholder="@CatalogResources.Get("Price")"/> </td>
            <td> <input class="form-control form-control-sm column-search" data-field="quantity" placeholder="@CatalogResources.Get("Quantity")"/> </td>
            <td>
                <select class="form-select form-select-sm column-search" data-field="categoryId"
                        asp-items="ViewBag.Categories" aria-label="@CatalogResources.Get("Category")">
                    <option value="">@CatalogResources.Get("AllCategories")</option>
                </select>
            </td>
            <td> <input class="form-control form-control-sm column-search" data-field="created" placeholder="@CatalogResources.Get("CreatedDate")"/> </td>
        </tr>
        </thead>
    
        <tbody id="about-table-body" class="table-group-divider">
        </tbody>
    </table>
    <nav aria-label="@CatalogResources.Get("Pagination")">
        <ul class="pagination pagination-sm" id="about-pagination"></ul>
    </nav>
    
</div>




@section Scripts
{ 
    <script src="~/js/src/areas/administrator/views/products/index.bundle.js"></script>
}
