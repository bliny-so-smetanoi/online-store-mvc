@using System.Globalization
@using Resource
@model Application.UseCases.Orders.Dtos.VisitorCartDto
@{
    ViewData["Title"] = CatalogResources.Get("Checkout");
    var priceCulture = CultureInfo.GetCultureInfo("en-US");
    var invalid = CatalogResources.Get("FieldInvalid");
}

<div class="container mt-4" id="checkout"
     data-place-order-url="@Url.Action("PlaceOrder", "Home")"
     data-title="@CatalogResources.Get("Checkout")"
     data-error-title="@CatalogResources.Get("Error")">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h2 mb-0"><i class="bi-bag-check"></i> @CatalogResources.Get("Checkout")</h1>
        <a class="btn btn-outline-secondary" asp-action="Cart" asp-controller="Home">
            <i class="bi-arrow-left"></i> @CatalogResources.Get("BackToCart")
        </a>
    </div>

    <div id="checkout-success" class="alert alert-success" role="status" hidden>
        <h2 class="h5 alert-heading"><i class="bi-check-circle"></i> @CatalogResources.Get("OrderPlaced")</h2>
        <p>@CatalogResources.Get("OrderPlacedMessage")</p>
        <a class="btn btn-primary" asp-action="Index" asp-controller="Home">@CatalogResources.Get("ContinueShopping")</a>
    </div>

    <div class="row g-4" id="checkout-content">
        <div class="col-lg-8">
            <form id="checkout-form" class="needs-validation" novalidate autocomplete="on">
                <section class="card mb-4" aria-labelledby="checkout-address-title">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-3" id="checkout-address-title">
                            <i class="bi-geo-alt"></i> @CatalogResources.Get("DeliveryAddress")
                        </h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="checkout-country">@CatalogResources.Get("Country")</label>
                                <input class="form-control" id="checkout-country" name="country" autocomplete="country-name"
                                       required maxlength="100">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="checkout-city">@CatalogResources.Get("City")</label>
                                <input class="form-control" id="checkout-city" name="city" autocomplete="address-level2"
                                       required maxlength="100">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="checkout-street">@CatalogResources.Get("Street")</label>
                                <input class="form-control" id="checkout-street" name="street" autocomplete="street-address"
                                       required maxlength="250">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="checkout-postal-code">@CatalogResources.Get("PostalCode")</label>
                                <input class="form-control" id="checkout-postal-code" name="postalCode" autocomplete="postal-code"
                                       required maxlength="20">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card mb-4" aria-labelledby="checkout-payment-title">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-3" id="checkout-payment-title">
                            <i class="bi-credit-card"></i> @CatalogResources.Get("PaymentDetails")
                        </h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="checkout-card-holder">@CatalogResources.Get("CardHolderName")</label>
                                <input class="form-control" id="checkout-card-holder" name="cardHolderName" autocomplete="cc-name"
                                       required maxlength="100">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="checkout-card-number">@CatalogResources.Get("CardNumber")</label>
                                <input class="form-control" id="checkout-card-number" name="cardNumber" autocomplete="cc-number"
                                       inputmode="numeric" placeholder="0000 0000 0000 0000" required
                                       pattern="[0-9 ]{12,23}" maxlength="23">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="checkout-expiration">@CatalogResources.Get("ExpirationDate")</label>
                                <input class="form-control" id="checkout-expiration" name="expirationDate" autocomplete="cc-exp"
                                       inputmode="numeric" placeholder="MM/YY" required
                                       pattern="(0[1-9]|1[0-2])/[0-9]{2}" maxlength="5">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="checkout-cvv">@CatalogResources.Get("Cvv")</label>
                                <input class="form-control" id="checkout-cvv" name="cvv" type="password" autocomplete="cc-csc"
                                       inputmode="numeric" required pattern="[0-9]{3,4}" maxlength="4">
                                <div class="invalid-feedback">@invalid</div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="alert alert-danger" id="checkout-error" role="alert" hidden></div>

                <button type="submit" class="btn btn-primary btn-lg" id="checkout-submit">
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true" hidden></span>
                    <i class="bi-bag-check"></i> @CatalogResources.Get("PlaceOrder")
                </button>
            </form>
        </div>

        <aside class="col-lg-4">
            <section class="card" aria-labelledby="checkout-summary-title">
                <div class="card-body">
                    <h2 class="h5 card-title mb-3" id="checkout-summary-title">
                        <i class="bi-receipt"></i> @CatalogResources.Get("OrderSummary")
                    </h2>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between gap-2">
                                <span>@item.Name <span class="text-secondary">× @item.Quantity</span></span>
                                <span class="text-nowrap">@item.TotalPrice.ToString("N2", priceCulture)</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>@CatalogResources.Get("CartTotal")</span>
                        <span>@Model.TotalPrice.ToString("N2", priceCulture)</span>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts
{
    <script src="~/js/src/views/home/checkout/index.bundle.js" asp-append-version="true"></script>
}
