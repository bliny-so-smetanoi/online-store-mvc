@using Resource
@{
    ViewData["Title"] = CatalogResources.Get("HomePage");
}

<div class="container-fluid" id="product-catalog"
     data-products-url="@Url.Action("GetProducts", "Home")"
     data-image-url="@Url.Action("ProductImage", "Home")"
     data-product-url="@Url.Action("Product", "Home")">
    <h1 class="display-4 text-center">@CatalogResources.Get("WelcomeToStore")</h1>

    <form id="product-search" class="container mt-5" role="search">
        <label for="product-search-input" class="visually-hidden">@CatalogResources.Get("SearchProducts")</label>
        <div class="input-group">
            <input id="product-search-input" name="searchString" type="search" class="form-control"
                   placeholder="@CatalogResources.Get("SearchPlaceholder")">
            <button type="submit" class="btn btn-primary" aria-label="@CatalogResources.Get("Search")"><i class="bi-search"></i></button>
        </div>
    </form>

    <section class="container mt-5" aria-label="@CatalogResources.Get("Products")">
        <div id="product-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" aria-busy="false"></div>
        <p id="products-loading" class="text-center mt-4" role="status" hidden>@CatalogResources.Get("LoadingProducts")</p>
        <p id="products-empty" class="text-center mt-4" role="status" hidden>@CatalogResources.Get("NoProductsFound")</p>
        <div id="products-error" class="alert alert-danger mt-4" role="alert" hidden>
            @CatalogResources.Get("ProductsLoadError")
            <button id="products-retry" type="button" class="btn btn-outline-danger ms-2">@CatalogResources.Get("TryAgain")</button>
        </div>
        <div class="text-center mt-5">
            <button id="products-show-more" type="button" class="btn btn-outline-info" hidden>@CatalogResources.Get("ShowMore")</button>
        </div>
        <noscript><p>@CatalogResources.Get("EnableJavaScript")</p></noscript>
    </section>

    <template id="product-card-template">
        <div class="col">
            <article class="card h-100">
                <img class="card-img-top object-fit-contain" height="220" loading="lazy" hidden>
                <div class="bg-light text-secondary text-center p-5" data-product-no-image>@CatalogResources.Get("NoImage")</div>
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">
                        <a class="stretched-link link-body-emphasis text-decoration-none" data-product-name></a>
                    </h2>
                    <h3 class="card-title h6" data-category-name></h3>
                    <p class="card-text" data-product-description></p>
                    <p class="card-text fw-bold mt-auto mb-0">@CatalogResources.Get("Price"): <span data-product-price></span></p>
                </div>
            </article>
        </div>
    </template>
</div>

@section Scripts
{
    <script src="~/js/src/views/home/index/index.bundle.js" asp-append-version="true"></script>
}
