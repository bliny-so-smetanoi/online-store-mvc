@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid" id="product-catalog"
     data-products-url="@Url.Action("GetProducts", "Home")"
     data-image-url="@Url.Action("ProductImage", "Home")">
    <h1 class="display-4 text-center">Welcome to OnlineStore</h1>

    <form id="product-search" class="container-md mt-5" role="search">
        <div class="row g-3">
            <div class="col-8">
                <label for="product-search-input" class="visually-hidden">Search products</label>
                <input id="product-search-input" name="searchString" type="search" class="form-control"
                       placeholder="Search for everything you desire...">
            </div>
            <div class="col-4">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </form>

    <section class="container mt-5" aria-label="Products">
        <div id="product-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" aria-busy="false"></div>
        <p id="products-loading" class="text-center mt-4" role="status" hidden>Loading products...</p>
        <p id="products-empty" class="text-center mt-4" role="status" hidden>No products found.</p>
        <div id="products-error" class="alert alert-danger mt-4" role="alert" hidden>
            Could not load products. Please try again.
            <button id="products-retry" type="button" class="btn btn-outline-danger ms-2">Try again</button>
        </div>
        <div class="text-center mt-5">
            <button id="products-show-more" type="button" class="btn btn-outline-info" hidden>Show more</button>
        </div>
        <noscript><p>Please enable JavaScript to browse products.</p></noscript>
    </section>

    <template id="product-card-template">
        <div class="col">
            <article class="card h-100">
                <img class="card-img-top object-fit-contain" height="220" loading="lazy" hidden>
                <div class="bg-light text-secondary text-center p-5" data-product-no-image>No image available</div>
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5" data-product-name></h2>
                    <p class="card-text" data-product-description></p>
                    <p class="card-text fw-bold mt-auto mb-0">Price: <span data-product-price></span></p>
                </div>
            </article>
        </div>
    </template>
</div>

@section Scripts
{
    <script src="~/js/src/views/home/index/index.bundle.js" asp-append-version="true"></script>
}
