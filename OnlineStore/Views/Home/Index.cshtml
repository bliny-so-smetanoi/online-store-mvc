@using KeycloakExtension
@using Resource
@model CSharpFunctionalExtensions.Result
@{
    ViewData["Title"] = @SharedResources.HomePage;
}

<div class="container-fluid">
    <h1 class="display-4 text-center">@SharedResources.WelcomeTitle</h1>
    
    <div class="container-md text-center mt-5">
        <div class="row g-3">
            <div class="col-8">
                <input type="text" class="form-control text-center" placeholder="Search for everything you desire...">    
            </div>
            <div class="col-4">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </div>
    
    <main class="container mt-5">
        <div class="row">
            <div class="col">
                <div class="card" style="width: 18rem;">
                    <img src="https://www.shutterstock.com/image-vector/example-red-rectangular-grunge-rubber-260nw-2715945217.jpg" class="card-img-top" >
                    <div class="card-body">
                        <h5 class="card-title">Product name</h5>
                        <p class="card-text">Product description</p>
                        <a href="#" class="btn btn-primary">Add to cart</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card" style="width: 18rem;">
                    <img src="https://www.shutterstock.com/image-vector/example-red-rectangular-grunge-rubber-260nw-2715945217.jpg" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Card title</h5>
                        <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                        <a href="#" class="btn btn-primary">Go somewhere</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card" style="width: 18rem;">
                    <img src="https://www.shutterstock.com/image-vector/example-red-rectangular-grunge-rubber-260nw-2715945217.jpg" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Card title</h5>
                        <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                        <a href="#" class="btn btn-primary">Go somewhere</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-sm d-flex justify-content-center align-items-center mt-5">
            <button class="btn btn-outline-info">Show more</button>
        </div>
    </main>
    
    @section Scripts
    {
        <script src="~/js/src/views/home/index/index.bundle.js"></script>
    }
</div>